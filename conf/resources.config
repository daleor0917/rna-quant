/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Unified Resource & Slurm Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Intelligent resource allocation with retry escalation
    - All configuration managed through process labels
    - Automatic node selection based on resource requirements
    - Retry escalation: lowmem → highmem with more resources
----------------------------------------------------------------------------------------
*/

// Slurm executor configuration
workDir = '/shared/work'

process {
    // Slurm defaults
    executor = 'slurm'
    queue    = 'lowmem'
    
    // Default resource requirements (very conservative)
    cpus   = { 1 * task.attempt }
    memory = { 1.GB * task.attempt }
    time   = { 30.m * task.attempt }

    // Error handling strategy with retry escalation
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'
    
    // Default cluster options
    clusterOptions = '--chdir=/shared'

    // ========================================
    // TINY PROCESSES - Always lowmem (nodoB)
    // ========================================
    
    withLabel: process_single {
        cpus   = { 1 }
        memory = { 1.GB * task.attempt }
        time   = { 30.m * task.attempt }
        queue  = 'lowmem'
    }
    
    // ========================================
    // SMALL PROCESSES - lowmem friendly
    // ========================================
    
    withLabel: process_low {
        cpus   = { 2 * task.attempt }
        memory = { 2.GB * task.attempt }  // 2GB → 4GB on retry
        time   = { 1.h * task.attempt }
        queue  = 'lowmem'
    }
    
    // ========================================
    // MEDIUM PROCESSES - May need escalation
    // ========================================
    
    withLabel: process_medium {
        cpus   = { 2 * task.attempt }
        memory = { 3.GB * task.attempt }  // 3GB → 6GB on retry
        time   = { 2.h * task.attempt }
        queue  = { task.attempt == 1 ? 'lowmem' : 'highmem' }  // Escalate to highmem on retry
    }
    
    // ========================================
    // HIGH PROCESSES - Start on highmem (nodoA)
    // ========================================
    
    withLabel: process_high {
        cpus   = { 2 * task.attempt }
        memory = { 6.GB * task.attempt }  // 6GB on nodoA
        time   = { 4.h * task.attempt }
        queue  = 'highmem'
    }
    
    withLabel: process_long {
        time   = { 8.h * task.attempt }
        queue  = 'lowmem'
    }
    
    withLabel: process_high_memory {
        cpus   = { 2 * task.attempt }
        memory = { 6.GB * task.attempt }  // 6GB on nodoA (max safe limit)
        time   = { 4.h * task.attempt }
        queue  = 'highmem'
    }
    
    // ========================================
    // ERROR HANDLING LABELS
    // ========================================
    
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }
    
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
        queue = 'highmem'
    }
}

// ========================================
// PROFILES
// ========================================

profiles {
    slurm {
        process.executor = 'slurm'
        process.queue    = 'lowmem'
        
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        
        workDir = '/shared/work'
    }
}

executor {
    name = 'slurm'
    queueSize = 10
    pollInterval = '10 sec'
    submitRateLimit = '5 sec'
}

