/*
========================================================================================
    SLURM Configuration
========================================================================================
    nodoA: 7.4GB RAM (highmem partition)
    nodoB: 3.6GB RAM (lowmem partition - default)
========================================================================================
*/

workDir = '/shared/work'

process {
    executor = 'slurm'
    
    // Debugging: ver dónde se ejecuta cada proceso
    beforeScript = 'echo "=== EJECUTANDO EN: $(hostname) - NODO: ${SLURM_NODELIST:-local} ==="'
    
    // Defaults - trabajos pequeños en lowmem (nodoB)
    cpus   = 1
    memory = '1 GB'
    time   = '1h'
    queue  = 'lowmem'
    clusterOptions = '--chdir=/shared'
    
    // ========================================
    // Trabajos pequeños (≤2GB) → lowmem partition (nodoB)
    // ========================================
    
    withName: 'NFCORE_FC:FC:SAMTOOLS_INDEX' {
        cpus   = 1
        memory = '1 GB'
        time   = '30m'
        queue  = 'lowmem'
        clusterOptions = '--chdir=/shared'
    }
    
    withName: 'NFCORE_FC:FC:CUSTOM_DUMPSOFTWAREVERSIONS' {
        cpus   = 1
        memory = '1 GB'
        time   = '10m'
        queue  = 'lowmem'
        clusterOptions = '--chdir=/shared'
    }
    
    withName: 'NFCORE_FC:FC:MULTIQC' {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
        queue  = 'lowmem'
        clusterOptions = '--chdir=/shared'
        container = 'quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0'
    }
    
    withName: 'NFCORE_FC:FC:FASTQC' {
        cpus   = 1
        memory = '2 GB'
        time   = '1h'
        queue  = 'lowmem'
        clusterOptions = '--chdir=/shared'
    }
    
    // ========================================
    // Trabajos grandes (>3GB) → highmem partition (nodoA)
    // ========================================
    
    withName: 'NFCORE_FC:FC:SUBREAD_FEATURECOUNTS' {
        cpus   = 2
        memory = '6 GB'
        time   = '2h'
        queue  = 'highmem'
        clusterOptions = '--chdir=/shared'
    }
    
    withName: 'NFCORE_FC:FC:RSEQC_TIN' {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
        queue  = 'highmem'
        clusterOptions = '--chdir=/shared'
    }
}

executor {
    name = 'slurm'
    queueSize = 10
    pollInterval = '10 sec'
    submitRateLimit = '5 sec'
}